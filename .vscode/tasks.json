{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-c-program",
            "type": "shell",
            "command": "clang",
            "args": [
                "-g",
                "snake.c",
                "-o",
                "main",
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "new"
            }
        }
    ]
}
